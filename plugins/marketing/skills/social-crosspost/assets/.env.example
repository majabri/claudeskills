# Copy to ~/.social-crosspost/.env and fill in. Never commit this file.

# Which platforms to post to by default
CROSSPOST_PLATFORMS=youtube,tiktok

# --- Instagram (source) ---
IG_ACCESS_TOKEN=
# Newer Meta apps (Unified login / Facebook Login for Business): the Instagram account ID
IG_USER_ID=
# Only for the older Instagram-login flow:
IG_APP_ID=
IG_APP_SECRET=
# IG_API_VERSION=v24.0

# --- YouTube ---
YT_CLIENT_ID=
YT_CLIENT_SECRET=
# YT_REFRESH_TOKEN=     # filled by: python scripts/auth.py youtube (stored in tokens.json)
YT_PRIVACY=public       # public | unlisted | private
YT_CATEGORY_ID=22

# --- TikTok ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_MODE=inbox       # inbox (draft, you tap publish) | direct (needs audit to be public)
TIKTOK_PRIVACY=PUBLIC_TO_EVERYONE

# --- X ---
X_CLIENT_ID=
X_CLIENT_SECRET=
X_STRIP_LINKS=true      # links raise the per-post price
X_MAX_SECONDS=140

# Redirect addresses registered in each developer app (only the landing address bar is read)
YT_REDIRECT_URI=http://localhost:8765/callback
TIKTOK_REDIRECT_URI=https://YOUR-DOMAIN/oauth/callback
X_REDIRECT_URI=http://localhost:8765/callback
